scene "precision_mounting_bracket" {
  units = m

  material titanium {
    base = "#8998a8"
    roughness = 0.28
    metallic = 0.82
  }

  material rubber {
    base = "#252a30"
    roughness = 0.88
  }

  # Closed 2D profile in X/Z, extruded through thickness along Y.
  extrude bracket_body {
    profile = [[0, 0], [0.48, 0], [0.48, 0.18], [0.19, 0.18], [0.19, 0.72], [0, 0.72]]
    depth = 0.12
    at = [-0.24, 0.09, -0.36]
    material = titanium
  }

  # Two heads on the horizontal foot. A full 2x2 grid would put one over the L-notch.
  array fasteners_horizontal {
    shape = cylinder
    counts = [2, 1, 1]
    step = [0.27, 0, 0]
    at = [-0.105, 0.16, -0.255]
    radius = 0.035
    height = 0.025
    material = rubber
  }

  # A separate pair on the upright flange keeps every head over solid material.
  array fasteners_vertical {
    shape = cylinder
    counts = [1, 1, 2]
    step = [0, 0, 0.27]
    at = [-0.145, 0.16, -0.07]
    radius = 0.035
    height = 0.025
    material = rubber
  }

  constraint horizontal_heads_supported {
    kind = supported_by
    object = fasteners_horizontal
    target = bracket_body
    tolerance = 0.01
  }

  constraint vertical_heads_supported {
    kind = supported_by
    object = fasteners_vertical
    target = bracket_body
    tolerance = 0.01
  }

  camera {
    at = [1.6, 1.3, 1.8]
    target = [0, 0.1, 0]
    fov = 44
  }

  light key {
    type = point
    at = [2.0, 2.8, 1.8]
    intensity = 450
    range = 8
  }
}
