# M3L v0.3 — a small, dimensioned wooden stool
scene "oak_stool" {
  units = m

  material oak {
    base = "#b77c45"
    roughness = 0.78
    metallic = 0.0
  }

  material steel {
    base = "#737d88"
    roughness = 0.32
    metallic = 0.72
  }

  material ground_mat {
    base = "#d8ddd9"
    roughness = 0.95
    metallic = 0.0
  }

  box ground {
    size = [4.0, 0.10, 4.0]
    at = [0.0, -0.05, 0.0]
    material = ground_mat
  }

  box seat {
    size = [0.48, 0.08, 0.48]
    at = [0.0, 0.54, 0.0]
    material = oak
  }

  # One declaration generates the four legs on a 2×1×2 grid.
  array stool_legs {
    shape = cylinder
    counts = [2, 1, 2]
    step = [0.34, 0, 0.34]
    at = [-0.17, 0.25, -0.17]
    radius = 0.025
    height = 0.50
    segments = 20
    material = steel
  }

  constraint seat_above_ground {
    kind = above
    object = seat
    target = ground
    axis = y
    gap = 0.50
    tolerance = 0.005
  }

  constraint back_left_leg_on_ground {
    kind = above
    object = stool_legs_0_0_0
    target = ground
    axis = y
    gap = 0.0
    tolerance = 0.005
  }

  camera {
    at = [1.45, 1.30, 1.85]
    target = [0.0, 0.37, 0.0]
    fov = 48
    near = 0.01
    far = 100
  }

  light key {
    type = point
    at = [1.6, 2.8, 1.5]
    color = "#fff2dd"
    intensity = 55
    range = 10
  }

  light fill {
    type = point
    at = [-2.0, 1.8, -1.0]
    color = "#dbe8ff"
    intensity = 15
    range = 8
  }
}
